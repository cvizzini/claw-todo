@page "/tenant"
@rendermode InteractiveServer
@using TodoApp.Web.Services
@using TodoApp.Web.Models
@using System.Net.Http.Json
@inject AuthService Auth
@inject NavigationManager Nav
@inject IHttpClientFactory HttpFactory
@implements IDisposable

<PageTitle>Tenant Admin – TodoApp</PageTitle>

@if (isCheckingAuth)
{
    <div class="loading-state"><div class="spinner"></div> Loading…</div>
    return;
}

@if (!Auth.IsTenantAdmin)
{
    <div class="admin-forbidden">
        <span>🔒</span>
        <h2>Access Denied</h2>
        <p>This area is restricted to tenant administrators.</p>
        <a href="/">← Back to my todos</a>
    </div>
    return;
}

<div class="admin-container">
    <div class="admin-header">
        <div>
            <h1>🏢 @(Auth.CurrentUser?.TenantName ?? "My Tenant")</h1>
            <p class="admin-sub">Manage users in your organisation</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="admin-alert @(isError ? "alert-error" : "alert-success")">
            @message
            <button @onclick="() => message = null">✕</button>
        </div>
    }

    <div class="admin-toolbar">
        <span class="toolbar-count">@users.Count user@(users.Count == 1 ? "" : "s")</span>
        <button class="btn-primary" @onclick="() => showUserForm = !showUserForm">
            @(showUserForm ? "✕ Cancel" : "+ New User")
        </button>
    </div>

    @if (showUserForm)
    {
        <div class="admin-form-card">
            <h3>Create User</h3>
            <div class="form-row">
                <div class="form-group">
                    <label>Email</label>
                    <input class="form-input" type="email" @bind="newUser.Email" placeholder="user@example.com" />
                </div>
                <div class="form-group">
                    <label>Display Name <span class="hint">(optional)</span></label>
                    <input class="form-input" @bind="newUser.DisplayName" placeholder="Jane Smith" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Password</label>
                    <input class="form-input" type="password" @bind="newUser.Password" placeholder="Min 6 chars + 1 digit" />
                </div>
                <div class="form-group">
                    <label>Role</label>
                    <select class="form-input" @bind="newUser.Role">
                        <option value="User">User</option>
                        <option value="TenantAdmin">TenantAdmin</option>
                    </select>
                </div>
            </div>
            <button class="btn-primary" @onclick="CreateUserAsync" disabled="@isBusy">
                @(isBusy ? "Creating…" : "Create User")
            </button>
        </div>
    }

    @if (isLoading)
    {
        <div class="loading-state"><div class="spinner"></div> Loading users…</div>
    }
    else if (users.Count == 0)
    {
        <div class="admin-empty">No users yet. Create one above.</div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Joined</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in users)
                    {
                        <tr class="@(u.IsLocked ? "row-locked" : "")">
                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar">@((u.DisplayName ?? u.Email)[0].ToString().ToUpper())</div>
                                    <div>
                                        <div class="user-name">@(u.DisplayName ?? u.Email)</div>
                                        <div class="user-email">@u.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="role-badge role-@u.Role.ToLower()">@u.Role</span></td>
                            <td>
                                @if (u.IsLocked)
                                {
                                    <span class="status-badge inactive">🔒 Locked</span>
                                }
                                else
                                {
                                    <span class="status-badge active">Active</span>
                                }
                            </td>
                            <td class="muted">@u.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                            <td>
                                <div class="action-group">
                                    @if (u.IsLocked)
                                    {
                                        <button class="btn-sm btn-success" @onclick="() => UnlockUserAsync(u.Id)">Unlock</button>
                                    }
                                    else if (u.Email != Auth.CurrentUser?.Email)
                                    {
                                        <button class="btn-sm btn-warn" @onclick="() => LockUserAsync(u.Id)">Lock</button>
                                    }
                                    @if (u.Email != Auth.CurrentUser?.Email)
                                    {
                                        <button class="btn-sm btn-danger" @onclick="() => DeleteUserAsync(u.Id, u.Email)">Delete</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private HttpClient Http = default!;
    private bool isLoading;
    private bool isBusy;
    private bool showUserForm;
    private string? message;
    private bool isError;
    private bool isCheckingAuth = true;
    private List<UserSummary> users = [];
    private CreateUserRequest newUser = new();

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuthChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            if (!Auth.IsAuthenticated)
                await Auth.TryRestoreSessionAsync();
        }
        catch (Exception ex)
        {
            ShowError($"Session restore failed: {ex.Message}");
        }
        finally
        {
            isCheckingAuth = false;
            StateHasChanged();
        }

        if (Auth.IsTenantAdmin)
        {
            Http = HttpFactory.CreateClient("TodoApi");
            Http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.CurrentUser!.Token);

            try
            {
                await LoadUsersAsync();
            }
            catch (Exception ex)
            {
                ShowError($"Failed to load data: {ex.Message}");
                StateHasChanged();
            }
        }
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.AuthStateChanged -= OnAuthChanged;

    private async Task LoadUsersAsync()
    {
        isLoading = true;
        StateHasChanged();
        try { users = await Http.GetFromJsonAsync<List<UserSummary>>("/api/v1/tenant/users") ?? []; }
        catch { ShowError("Failed to load users."); }
        finally 
        { 
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CreateUserAsync()
    {
        if (string.IsNullOrWhiteSpace(newUser.Email) || string.IsNullOrWhiteSpace(newUser.Password))
        { ShowError("Email and password are required."); return; }

        isBusy = true;
        var resp = await Http.PostAsJsonAsync("/api/v1/tenant/users", new
        {
            newUser.Email, newUser.Password, newUser.DisplayName, newUser.Role
        });
        isBusy = false;

        if (resp.IsSuccessStatusCode)
        {
            ShowSuccess($"User '{newUser.Email}' created.");
            newUser = new();
            showUserForm = false;
            await LoadUsersAsync();
        }
        else
        {
            var err = await TryReadError(resp);
            ShowError(err ?? "Failed to create user.");
        }
    }

    private async Task LockUserAsync(string id)
    {
        var resp = await Http.PatchAsync($"/api/v1/tenant/users/{id}/lock", null);
        if (resp.IsSuccessStatusCode) { ShowSuccess("User locked."); await LoadUsersAsync(); }
        else ShowError("Failed to lock user.");
    }

    private async Task UnlockUserAsync(string id)
    {
        var resp = await Http.PatchAsync($"/api/v1/tenant/users/{id}/unlock", null);
        if (resp.IsSuccessStatusCode) { ShowSuccess("User unlocked."); await LoadUsersAsync(); }
        else ShowError("Failed to unlock user.");
    }

    private async Task DeleteUserAsync(string id, string email)
    {
        var resp = await Http.DeleteAsync($"/api/v1/tenant/users/{id}");
        if (resp.IsSuccessStatusCode) { ShowSuccess($"User '{email}' deleted."); await LoadUsersAsync(); }
        else ShowError("Failed to delete user.");
    }

    private void ShowSuccess(string msg) { message = msg; isError = false; }
    private void ShowError(string msg) { message = msg; isError = true; }

    private static async Task<string?> TryReadError(HttpResponseMessage resp)
    {
        try
        {
            var doc = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            if (doc.TryGetProperty("error", out var e)) return e.GetString();
        }
        catch { }
        return null;
    }
}
